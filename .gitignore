# persistent-memory workspace — ignore regenerable + build artifacts.

# The Prisma 7 generated client (regenerated by `npm run prisma:generate`).
# Lives at persistent-memory/generated/ (a sibling of packages/db/, apps/api/, packages/shared/). The
# prisma/.gitignore `/generated/` entry only matches prisma/generated/ (which
# does not exist) — this is the real output dir, and it must be ignored so the
# regenerable client never dirties git status or gets committed.
/generated/

# Per-package build output (tsc).
/dist/
packages/shared/dist/
packages/db/dist/
api/dist/
worker/dist/
apps/api/dist/
apps/worker/dist/
apps/dashboard-gateway/dist/
apps/docker-control/dist/
apps/update-runner/dist/
apps/onboard/dist/
layers/core/tools/dist/
layers/mcp-runtime/dist/
layers/memory-vector/dist/
layers/graph/dist/
layers/evidence-files/dist/
layers/security-dlp/dist/
# Onboarding installer SPA build output (host-only app; never committed/shipped).
apps/onboard/web/dist/
*.tsbuildinfo

# Phase 12 migration tool — generated reports + scratch fixtures (the committed
# synthetic fixture under layers/core/tools/.fixtures-phase12/ is kept; ad-hoc reports are not).
layers/core/tools/migrate-report-*.json
snapshots/migrate-report-*.json

# Workspace install.
node_modules/

# Local browser-capture logs and temporary screenshots.
.playwright-mcp/

# Python cache output from graphiti-service tests.
__pycache__/
*.py[cod]

# Plan state (gitignored per plan-mode conventions).
*-state.json
.codex/critical-development-parked/

# Local Codex runtime overrides are machine-specific and must not be released.
.codex/config.toml

# Local-only documentation. Committed docs live in documentation/; the raw
# deep-dive/process markdown stays on disk under docs/internal/, untracked.
docs/internal/

# Generated visual documentation exports are not committed. Keep the Markdown
# documentation tree under documentation/ as the source of truth.
documentation/storybook/

# macOS Finder junk.
.DS_Store

# Local env (secrets live here). Commit .env.persistent-memory.example instead.
.env.persistent-memory

# Local operator artifacts (DB dumps, scratch recovery files, etc.).
.local/

# Throwaway dev smoke scripts / scratch files (e.g. backfill-smoke.sh, reconciler-smoke.sh).
scratchpad/
