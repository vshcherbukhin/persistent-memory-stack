# persistent-memory — environment template.
# Copy to .env.persistent-memory (gitignored) and fill the secrets below.
# Service-to-service wiring uses container names + internal ports; the host
# port maps in docker-compose.yml are for your laptop only.

# ── Secrets — fill locally, never commit ──
# API keys: YOU supply these (leave a provider blank to omit it).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
# TOKEN_PEPPER: a server-side secret mixed into every token hash (argon2id) so a
# stolen DB dump can't be brute-forced offline. The onboarding wizard/CLI installer
# generates it. It must stay STABLE for the life of the deployment: changing it
# invalidates every issued token, including the bootstrap token.
TOKEN_PEPPER=
# Host port bind address for developer-facing services. Keep loopback unless
# you are deliberately exposing the stack behind a trusted firewall/proxy.
PM_HOST_BIND=127.0.0.1

# ── Embeddings ──
# EMBED_PROVIDER = backend (ollama|voyage|openai); EMBEDDING_MODE = topology
# (server = API embeds | client-bridge = MCP embeds, server runs none).
# Ollama runs on the host. EMBED_DIM must match the model (qwen3:4b ∈ {2560,1024,768,512,256}).
# Default local model is qwen3-embedding:4b @ 2560; on CPU-only hosts use 0.6b @ 1024.
OLLAMA_URL=http://host.docker.internal:11434
EMBED_PROVIDER=ollama
EMBED_MODEL=qwen3-embedding:4b
EMBED_DIM=2560
EMBEDDING_MODE=server
# Optional: EMBED_BATCH_SIZE, EMBED_MAX_RETRIES (4), EMBED_TIMEOUT_MS (30000).

# ── LLM extraction (entities/edges) ──
# Default: Anthropic claude-haiku-4-5-20251001 — the deliberate default (cheaper + faster,
# like mem0; works with a Haiku-capable token). Bump to claude-sonnet-4-6 (or OpenAI gpt-4o)
# only if you want higher extraction quality and have a key for it.
EXTRACTION_PROVIDER=anthropic
EXTRACTION_MODEL=claude-haiku-4-5-20251001

# ── Graph backend: falkordb | neo4j ──
GRAPH_BACKEND=falkordb
SEMAPHORE_LIMIT=10
# FalkorDB (primary)
FALKORDB_HOST=persistent-memory-falkordb
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
# Bound each FalkorDB read query. Graphiti also caps full-text candidate terms
# and falls back to its vector/BFS signals if this bounded read times out.
FALKORDB_QUERY_TIMEOUT_MS=5000
# Neo4j (alt; compose profile "neo4j"). Keep NEO4J_USER/PASSWORD in sync with NEO4J_AUTH.
NEO4J_AUTH=neo4j/persistentmemory
NEO4J_URI=bolt://persistent-memory-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=persistentmemory

# ── Qdrant (vectors) ──
QDRANT_URL=http://persistent-memory-qdrant:6333
QDRANT_API_KEY=

# ── Postgres ──
# Two roles: pm_app = runtime, RLS-enforced (DATABASE_URL); pmuser = owner for
# migrate/seed + control plane (DATABASE_MIGRATE_URL). PM_APP_PASSWORD (injected
# into pm_app by rls.sql) must match the password in DATABASE_URL.
POSTGRES_USER=pmuser
POSTGRES_PASSWORD=
POSTGRES_DB=persistent_memory
PM_APP_PASSWORD=
DATABASE_URL=
DATABASE_MIGRATE_URL=

# ── Redis (BullMQ) ──
REDIS_URL=redis://persistent-memory-redis:6379

# ── MinIO (object store) ──
MINIO_ROOT_USER=pmadmin
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=http://persistent-memory-minio:9000

# ── Graphiti service ──
GRAPHITI_URL=http://persistent-memory-graphiti:8100

# ── API ──
API_PORT=8090
# Deployment mode (Phase 13). `server` (default) = full token auth, multi-team.
# `local` = a SINGLE-USER, NO-AUTH stack (the onboard full-local flow sets this):
# the api injects one synthetic super-user + the dashboard skips login. NEVER set
# `local` on a shared or networked deployment. Changing it needs a rebuild (the admin
# bakes it at build time). Default server.
DEPLOYMENT_MODE=server
# Argon2 (token hashing)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ── MCP runtime ──
# stream = shared Docker Streamable HTTP service; node = local stdio process per
# agent session. The full-local wizard defaults to stream.
PM_MCP_RUNTIME=stream
PM_MCP_STREAM_URL=http://127.0.0.1:8091/mcp

# ── Memory surfaces ──
# shared-only = company/server memory only; personal-only = local private memory
# only; personal-and-shared = local private memory plus explicit shared routing.
PM_PERSONAL_MEMORY_ENABLED=false
PM_MEMORY_INSTALL_MODE=shared-only
PM_DEFAULT_MEMORY_SURFACE=shared
PM_MEMORY_GRAPH_UI_ENABLED=true
PM_PERSONAL_API_URL=http://localhost:8090
PM_SHARED_API_URL=
PM_SHARED_USER_TOKEN=

# ── Services control (docker-control sidecar) ──
# Shared secret the api presents to the docker-control sidecar (the only container
# with the Docker socket). EMPTY ⇒ the sidecar fails closed and the Services page
# shows "control unavailable". The onboarding wizard generates this; install.sh
# fills it if blank. The sidecar publishes NO host port (internal network only).
DOCKER_CONTROL_TOKEN=
# Shared secret the api presents to the update-runner sidecar. EMPTY ⇒ dashboard
# update status checks fail closed. Wizard/install scripts generate it.
UPDATE_RUNNER_TOKEN=
# Shared secret for the api's POST /internal/usage (graphiti reports LLM token usage
# for the dashboard Usage page). EMPTY ⇒ the endpoint rejects all. Wizard generates it.
USAGE_INGEST_TOKEN=
# The sidecar runs as the non-root `node` user and joins this group to read the
# Docker socket. Docker Desktop (macOS/Windows): leave 0 (socket is root:root 660).
# Native LINUX: set to the host docker-group gid — `stat -c '%g' /var/run/docker.sock`
# — else the sidecar can't reach the socket (Services page degrades to 503).
DOCKER_GID=0

# ── Dashboard update notifications (full-local only, optional) ──
# none = no dashboard update checks. bitbucket = read-only Bitbucket/Stash REST
# checks using the fields below. This does NOT enable one-click updating; the
# dashboard shows release notes and the terminal command to run manually.
UPDATE_CHECK_PROVIDER=none
UPDATE_BITBUCKET_URL=
UPDATE_BITBUCKET_TOKEN=
# project = /projects/<key>/repos/<repo>, user = /users/<slug>/repos/<repo>
UPDATE_BITBUCKET_SCOPE=project
UPDATE_BITBUCKET_PROJECT=
UPDATE_BITBUCKET_USER=
UPDATE_BITBUCKET_REPO=
UPDATE_BITBUCKET_BRANCH=master

# ── DLP / PII gate (Phase 8) ──
# The dlp sidecar (Presidio + gitleaks) is internal-only; the api/worker call it.
# PII_GATE_ENABLED=false disables the synchronous memory write-gate (NOT recommended).
# An unreachable sidecar always fails CLOSED (blocks the write) regardless.
PII_GATE_ENABLED=true
# Block these PII entity types on writes (comma-separated). EMPTY ⇒ a safe built-in
# default of STRUCTURED PII only (US_SSN, CREDIT_CARD, EMAIL_ADDRESS, IBAN_CODE,
# CRYPTO, PHONE_NUMBER, IP_ADDRESS, US_PASSPORT, US_ITIN) — deliberately NOT the
# noisy NER entities PERSON/LOCATION/DATE_TIME.
PII_ENTITIES=
PII_SCORE_THRESHOLD=0.5
DLP_TIMEOUT_MS=4000
# Worker-side toggle: block sensitive DOCUMENT ingests. (The periodic pii-scan is
# enabled/paused per-job from the dashboard Workers page — no separate env flag.)
PII_INGEST_GATE_ENABLED=true

# ── Security-alert notifications (Phase 8) — best-effort, never block a write ──
# SMTP RELAY credentials live here (the SMTP_PASS secret stays out of the DB). Per-team
# recipients + Slack webhooks live in the NotifySettings control table (admin UI). A
# global super-admin NotifySettings row fans alerts across ALL teams to the support
# team. EMPTY SMTP_HOST ⇒ the email channel is a silent no-op (Slack still works).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=

# ── Memory rerank (Phase 9) — advanced tuning ──
# Retrieval score = α·relevance + β·recency-decay + γ·importance, gated by
# provenance × confidence. The user-facing retention knobs (archive confidence
# threshold + TTL days) are dashboard-configurable (Settings → Memory retention);
# these weights are env-only.
RERANK_ALPHA=1.0
RERANK_BETA=0.3
RERANK_GAMMA=0.2
RERANK_HALFLIFE_DAYS=30
