{
  "name": "persistent-memory-onboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "One-command onboarding installer web app for persistent-memory (host-only; NOT shipped to the server).",
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node ../../scripts/onboard-assets.mjs",
    "start": "node dist/apps/onboard/server/index.js",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
