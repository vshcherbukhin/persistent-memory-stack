{
  "name": "persistent-memory-documentation",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "description": "Versioned MkDocs build assets and dependency-free Node runtime for Persistent Memory documentation.",
  "scripts": {
    "diagrams:check": "node scripts/render-mermaid-fallbacks.mjs --check",
    "diagrams:render": "node scripts/render-mermaid-fallbacks.mjs",
    "start": "node src/server.mjs",
    "launch": "node src/launcher.mjs",
    "test": "node --test test/documentation.test.mjs"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0",
    "mermaid": "12.2.0"
  },
  "overrides": {
    "@mermaid-js/mermaid-cli": {
      "katex": "0.18.10"
    }
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  }
}
