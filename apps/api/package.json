{
  "name": "persistent-memory-api",
  "version": "2.0.2",
  "private": true,
  "description": "persistent-memory API (Phase 3) — the single authorization choke-point + identity layer. Fastify + Zod + Prisma 7 (PrismaPg adapter) + argon2id token auth + Postgres RLS tenant context.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -b tsconfig.json",
    "test": "npm run build -w @pm/memory-vector && npm run build -w @pm/graph && npm run build -w @pm/evidence-files && npm run build -w @pm/security-dlp && vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@fastify/multipart": "9.4.0",
    "@pm/db": "*",
    "@pm/evidence-files": "*",
    "@pm/graph": "*",
    "@pm/memory-vector": "*",
    "@pm/security-dlp": "*",
    "@pm/shared": "*",
    "argon2": "0.45.1",
    "bullmq": "5.81.5",
    "dotenv": "17.4.2",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "5.11.1",
    "openai": "6.49.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/web-push": "3.6.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
