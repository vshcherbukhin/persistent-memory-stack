{
  "name": "@pm/shared",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "persistent-memory shared core — embedding adapter (ollama/voyage/openai), Qdrant multi-tenant vector layer (named vectors + is_tenant), the dimension/provider switch tool, MinIO blob storage, the BullMQ ingest queue contract, and text extraction + token-aware chunking. Prisma-FREE: deals in plain bytes/vectors/payloads + string ids; callers own the DB.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embeddings": {
      "types": "./dist/embeddings/index.d.ts",
      "import": "./dist/embeddings/index.js"
    },
    "./qdrant": {
      "types": "./dist/qdrant/index.d.ts",
      "import": "./dist/qdrant/index.js"
    },
    "./switch": {
      "types": "./dist/switch/index.d.ts",
      "import": "./dist/switch/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.js"
    },
    "./extract": {
      "types": "./dist/extract/index.d.ts",
      "import": "./dist/extract/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "bin": {
    "pm-switch-embedding": "./dist/switch/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "switch": "tsx src/switch/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@aws-sdk/lib-storage": "3.1159.0",
    "@aws-sdk/s3-request-presigner": "3.1159.0",
    "@qdrant/js-client-rest": "1.18.0",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "js-tiktoken": "1.0.21",
    "mammoth": "1.13.0",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
