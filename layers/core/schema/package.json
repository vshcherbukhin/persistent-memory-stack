{
  "name": "persistent-memory-prisma",
  "version": "2.0.0",
  "private": true,
  "description": "Prisma schema, RLS policies and bootstrap seed for the persistent-memory data model (Phase 2).",
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "rls": "PGOPTIONS=\"-c pm.app_password=${PM_APP_PASSWORD:-pmapp}\" psql \"$DATABASE_MIGRATE_URL\" -v ON_ERROR_STOP=1 -f rls.sql",
    "seed": "tsc -p tsconfig.seed.json && node dist/layers/core/schema/seed.js",
    "validate": "prisma validate"
  },
  "prisma": {
    "seed": "npm run seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
