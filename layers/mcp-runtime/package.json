{
  "name": "@pm/mcp-runtime",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "persistent-memory MCP runtime layer: tool registrars, recall-context orchestration, stream-session helpers, API client, and client-managed embedding bridge.",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
