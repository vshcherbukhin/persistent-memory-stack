{
  "name": "@pm/graph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "persistent-memory graph capability layer: Graphiti client, memory graph sync stamping, and worker Graphiti episode helpers.",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@pm/db": "*",
    "@pm/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.7.2"
  }
}
